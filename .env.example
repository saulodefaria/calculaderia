SITE_URL=http://localhost:3000/

# Database (Postgres)
POSTGRES_PORT=5438
POSTGRES_DB=calculaderia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Keep this port in sync with POSTGRES_PORT.
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/calculaderia?schema=public"

# Agent backlog source of truth (local automation only; used by psql scripts).
AGENT_BACKLOG_DATABASE_URL="postgresql://postgres:postgres@localhost:5438/calculaderia"

# Auth.js / Google OAuth
AUTH_SECRET="replace-with-a-random-secret"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Google Analytics 4 (GA4)
# Replace this with your real Measurement ID (looks like "G-XXXXXXXXXX")
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
